# Copy to firmware/secrets.yaml and fill in. secrets.yaml is gitignored.
#
# The device is already adopted into Home Assistant, so api_encryption_key and
# ota_password must match what it is running now. Find both in the ESPHome
# dashboard: open the device, click Edit, and copy the values from
# `api.encryption.key` and `ota.password`. Using different values means the OTA
# push is rejected and you have to reflash over USB.

wifi_ssid: "your-network"
wifi_password: "your-wifi-password"

# Fallback access point, used only if Wi-Fi fails. Minimum 8 characters.
ap_password: "changeme-8chars"

# 32 bytes, base64. Generate a fresh one with:
#   openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_THE_KEY_YOUR_DEVICE_ALREADY_USES"

ota_password: "REPLACE_WITH_THE_PASSWORD_YOUR_DEVICE_ALREADY_USES"
